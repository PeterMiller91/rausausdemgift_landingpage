# ------------------------------------------------------------
# Vorlage für die .env – raus aus dem gift / Morgenlicht
#
# 1. Diese Datei kopieren und als .env speichern:  cp .env.example .env
# 2. Werte eintragen. Die .env steht in .gitignore und wird nie hochgeladen.
# 3. Echte Schlüssel gehören NUR in die .env bzw. ins Netlify-Dashboard,
#    niemals in diese Vorlage.
# ------------------------------------------------------------


# ========== BREVO ==========
# Netlify Function newsletter-anmelden.mjs (Anmeldeformular)
# Live-Betrieb: dieselben Werte in Netlify unter
#   Project configuration → Environment variables eintragen.
# Lokal liest `netlify dev` diese .env automatisch.

# Brevo → SMTP & API → API-Keys → „Neuen API-Key erstellen“
BREVO_API_KEY=

# Liste „Newsletter RADG“
BREVO_LIST_ID=12

# Vorlage „RADG NEWSLETTER DEFAULT Double OptIn“
BREVO_DOI_TEMPLATE=8

# Seite, auf der man nach dem Klick in der Bestätigungsmail landet
DOI_REDIRECT_URL=https://www.rausausdemgift.de/


# ========== TELEGRAM-BOT ==========
# Freigabe des Newsletters (n8n-Workflow automation/newsletter-freigabe)
# In n8n werden Token und Keys als Zugangsdaten (Credentials) hinterlegt,
# nicht über diese Datei – hier stehen sie zum Nachschlagen an einem Ort.

# Telegram → @BotFather → /newbot → Token kopieren
TELEGRAM_BOT_TOKEN=

# Dem eigenen Bot /id schicken, er antwortet mit der Chat-ID
TELEGRAM_CHAT_ID=

# Adresse, an die vor der Freigabe die Testmail geht
NEWSLETTER_TEST_EMAIL=


# ========== CLAUDE (Überarbeitungen per Telegram) ==========
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
