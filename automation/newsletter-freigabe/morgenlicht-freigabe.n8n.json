    },
    {
      "parameters": {
        "jsCode": "const res = $json;\nconst prev = $('Anfrage an Claude bauen').first().json;\nconst fail = message => [{ json: { ok: false, chatId: 'DEINE_TELEGRAM_CHAT_ID', message: '⚠️ ' + message } }];\n\nif (res.error) return fail('Claude war nicht erreichbar: ' + (res.error.message || JSON.stringify(res.error)));\nif (res.stop_reason === 'refusal') return fail('Claude hat die Überarbeitung abgelehnt. Formuliere den Wunsch bitte anders.');\nif (res.stop_reason === 'max_tokens') return fail('Die überarbeitete Fassung war zu lang und wurde abgeschnitten. Der Entwurf ist unverändert.');\n\nconst text = (res.content || []).filter(b => b.type === 'text').map(b => b.text).join('');\nconst pick = tag => {\n  const m = text.match(new RegExp(`<${tag}>([\\\\s\\\\S]*?)</${tag}>`));\n  return m ? m[1].trim() : null;\n};\nconst html = pick('html');\nif (!html || html.length < 200) return fail('Claude hat kein vollständiges HTML geliefert. Der Entwurf ist unverändert.');\n\nreturn [{ json: {\n  ok: true,\n  campaignId: prev.campaignId,\n  subject: pick('subject') || prev.subject,\n  previewText: pick('preview') ?? prev.previewText,\n  htmlContent: html,\n  summary: pick('summary') || '',\n} }];\n"
      },
