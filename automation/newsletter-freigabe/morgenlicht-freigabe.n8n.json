      "parameters": {
        "jsCode": "// Nächster Sonntag 08:00 (Europe/Berlin). Ist es Sonntag nach 8 Uhr, geht er in 10 Minuten raus.\nconst item = $('Antwort auswerten').first().json;\nconst now = DateTime.now().setZone('Europe/Berlin');\nlet when = now.set({ hour: 8, minute: 0, second: 0, millisecond: 0 }).plus({ days: (7 - now.weekday) % 7 });\nif (when <= now) when = now.weekday === 7 ? now.plus({ minutes: 10 }) : when.plus({ weeks: 1 });\nreturn [{ json: {\n  campaignId: item.campaignId,\n  scheduledAt: when.toISO(),\n  label: when.setLocale('de').toFormat(\"cccc, dd.MM. 'um' HH:mm 'Uhr'\"),\n} }];\n"
      },
