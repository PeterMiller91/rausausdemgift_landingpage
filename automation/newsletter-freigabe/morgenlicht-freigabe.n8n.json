        "jsCode": "const c = $json;\n$getWorkflowStaticData('global').lastCampaignId = c.id;\n\nlet summary = '';\ntry { summary = $('Antwort von Claude auswerten').first().json.summary || ''; } catch (e) {}\n\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst plain = String(c.htmlContent || '')\n  .replace(/<(style|script|head)[\\s\\S]*?<\\/\\1>/gi, '')\n  .replace(/<br\\s*\\/?>/gi, '\\n')\n  .replace(/<\\/(p|h[1-6]|div|tr|li)>/gi, '\\n')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&nbsp;/g, ' ').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\")\n  .replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&')\n  .replace(/[ \\t]+/g, ' ').replace(/\\n\\s*\\n+/g, '\\n\\n').trim();\nconst MAX = 2800;  // Telegram erlaubt 4096 Zeichen pro Nachricht\nconst excerpt = plain.length > MAX ? plain.slice(0, MAX) + ' …' : plain;\n\nlet text = '';\nif (summary) text += `✏️ <b>Überarbeitet:</b> ${esc(summary)}\\n\\n`;\ntext += `📬 <b>Morgenlicht #${c.id}</b>\\n<b>Betreff:</b> ${esc(c.subject)}\\n<b>Vorschautext:</b> ${esc(c.previewText)}\\n\\n`;\ntext += `${esc(excerpt)}\\n\\n`;\ntext += 'Die Testmail ist in deinem Postfach. Freigeben – oder antworte auf diese Nachricht mit deinen Änderungswünschen.';\nreturn [{ json: { campaignId: c.id, text } }];\n"
      },
