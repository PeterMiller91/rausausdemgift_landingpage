    {
      "parameters": {
        "jsCode": "const CHAT_ID = 'DEINE_TELEGRAM_CHAT_ID';\nconst u = $json;\n\n// Button gedrückt\nif (u.callback_query) {\n  const cq = u.callback_query;\n  if (String(cq.message?.chat?.id) !== CHAT_ID) return [];   // fremde Chats ignorieren\n  const [action, id] = String(cq.data || '').split(':');\n  return [{ json: { action, campaignId: Number(id), callbackId: cq.id } }];\n}\n\n// Textnachricht\nconst m = u.message;\nif (!m || !m.text) return [];\nconst text = m.text.trim();\n\n// Einrichtung: /id verrät dir deine Chat-ID\nif (text === '/id' || text === '/start') {\n  return [{ json: { action: 'notice', chatId: m.chat.id, message: `Deine Chat-ID: ${m.chat.id}` } }];\n}\nif (String(m.chat.id) !== CHAT_ID) return [];\n\n// Welcher Entwurf? Aus der beantworteten Nachricht (#123), sonst der zuletzt gezeigte\nconst ref = m.reply_to_message?.text || '';\nconst hit = ref.match(/#(\\d+)/);\nconst campaignId = hit ? Number(hit[1]) : $getWorkflowStaticData('global').lastCampaignId;\nif (!campaignId) {\n  return [{ json: { action: 'notice', chatId: CHAT_ID,\n    message: 'Ich weiß nicht, welcher Entwurf gemeint ist. Antworte bitte direkt auf die Vorschau-Nachricht.' } }];\n}\nreturn [{ json: { action: 'revise', campaignId, wish: text } }];\n"
      },
