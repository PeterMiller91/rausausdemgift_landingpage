      "parameters": {
        "jsCode": "// Neuester Brevo-Entwurf mit dem Tag \"morgenlicht\" (legt die Cowork-Aufgabe an)\nconst campaigns = $json.campaigns || [];\nconst draft = campaigns.find(c => String(c.tag || '').toLowerCase() === 'morgenlicht');\nif (!draft) {\n  return [{ json: { found: false, chatId: 'DEINE_TELEGRAM_CHAT_ID',\n    message: '⚠️ Ich habe in Brevo keinen Morgenlicht-Entwurf (Tag „morgenlicht“) gefunden. Ist die Cowork-Aufgabe gelaufen?' } }];\n}\nreturn [{ json: { found: true, campaignId: draft.id } }];\n"
      },
